{
  "displayName": "CA02-BlockNonGermanLogins",
  "state": "enabled",
  "conditions": {
    "users": {
      "includeUsers": ["All"],
      "excludeUsers": ["BreakGlassAdmins"]
    },
    "locations": {
      "includeLocations": ["All"],
      "excludeLocations": ["Germany-Trusted-Locations"]
    },
    "clientAppTypes": ["all"]
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": ["block"]
  },
  "sessionControls": {},
  "complianceReference": {
    "iso27001:2022": "Control 5.15 (Access Control) & Control 8.14 (Redundancy of information processing facilities)"
  }
}